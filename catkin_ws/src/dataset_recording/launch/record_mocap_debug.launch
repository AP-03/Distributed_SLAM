<launch>
  <arg name="server_ip" default="192.168.1.230"/>
  <arg name="frame_id" default="mocap_world"/>
  <arg name="run_id" default="mocap_debug_run"/>
  <arg name="output_root" default="$(env HOME)/Distributed_SLAM/runs"/>
  <arg name="operator" default="$(env USER)"/>
  <arg name="notes" default="mocap debug LED wave"/>
  <arg name="show_rviz" default="true"/>

  <include file="$(find dataset_ground_truth)/launch/mocap_debug_live.launch">
    <arg name="server_ip" value="$(arg server_ip)"/>
    <arg name="frame_id" value="$(arg frame_id)"/>
    <arg name="show_rviz" value="$(arg show_rviz)"/>
  </include>

  <node name="record_mocap_debug"
        pkg="dataset_recording"
        type="record_one_robot.py"
        output="screen"
        required="true">
    <param name="robot_id" value="mocap_debug"/>
    <param name="scenario" value="mocap_debug"/>
    <param name="run_id" value="$(arg run_id)"/>
    <param name="output_root" value="$(arg output_root)"/>
    <param name="operator" value="$(arg operator)"/>
    <param name="notes" value="$(arg notes)"/>
    <rosparam command="load" file="$(find dataset_recording)/config/mocap_debug_topics.yaml"/>
  </node>
</launch>
