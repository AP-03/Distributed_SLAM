<launch>
  <arg name="server_ip" default="192.168.1.230"/>
  <arg name="frame_id" default="mocap_world"/>
  <arg name="show_rviz" default="true"/>
  <arg name="rviz_config" default="$(find dataset_ground_truth)/rviz/mocap_debug.rviz"/>
  <arg name="max_path_points" default="4000"/>

  <include file="$(find phasespace_bringup)/launch/phasespace_mocap.launch">
    <arg name="server_ip" value="$(arg server_ip)"/>
    <arg name="display" value="false"/>
  </include>

  <node name="phasespace_retimestamp"
        pkg="dataset_ground_truth"
        type="phasespace_retimestamp_node.py"
        output="screen">
    <param name="frame_id" value="$(arg frame_id)"/>
  </node>

  <node name="mocap_debug_visualizer"
        pkg="dataset_ground_truth"
        type="mocap_debug_visualizer.py"
        output="screen">
    <param name="fixed_frame" value="$(arg frame_id)"/>
    <param name="markers_topic" value="/phasespace/stamped/markers"/>
    <param name="rigids_topic" value="/phasespace/stamped/rigids"/>
    <param name="max_path_points" value="$(arg max_path_points)"/>
  </node>

  <node if="$(arg show_rviz)"
        name="mocap_debug_rviz"
        pkg="rviz"
        type="rviz"
        args="-d $(arg rviz_config)"
        output="screen"/>
</launch>
