<launch>
  <arg name="robot_id" default="robot_01"/>
  <arg name="config" default="$(find dataset_ground_truth)/config/robot_01.yaml"/>

  <rosparam command="load" file="$(arg config)"/>

  <node name="$(arg robot_id)_ground_truth"
        pkg="dataset_ground_truth"
        type="phasespace_ground_truth_node.py"
        output="screen">
    <param name="robot_id" value="$(arg robot_id)"/>
  </node>
</launch>
