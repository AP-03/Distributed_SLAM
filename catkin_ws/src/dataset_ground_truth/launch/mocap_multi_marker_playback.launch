<launch>
  <arg name="bag"/>
  <arg name="frame_id" default="mocap_world"/>
  <arg name="rate" default="1.0"/>
  <arg name="start" default="0.0"/>
  <arg name="loop" default="false"/>
  <arg name="regenerate_gt" default="false"/>
  <arg name="use_raw_phasespace" default="false"/>
  <arg name="ground_truth_config" default="$(find dataset_ground_truth)/config/multi_robot_markers.yaml"/>
  <arg name="show_rviz" default="true"/>
  <arg name="rviz_config" default="$(find dataset_ground_truth)/rviz/mocap_debug.rviz"/>

  <param name="/use_sim_time" value="true"/>

  <!--
    Default mode replays the bag exactly as recorded. That avoids duplicate
    publishers on /gt and /mocap_debug, which otherwise makes RViz paths flicker
    and jump.

    Set regenerate_gt:=true to recompute GT from PhaseSpace source topics. In
    that mode rosbag only plays the PhaseSpace inputs, not recorded /gt outputs.
    Set use_raw_phasespace:=true only for bags without /phasespace/stamped/*.
  -->

  <group unless="$(arg regenerate_gt)">
    <node name="rosbag_play_once"
          unless="$(arg loop)"
          pkg="rosbag"
          type="play"
          args="--clock -s $(arg start) -r $(arg rate) $(arg bag)"
          output="screen"/>

    <node name="rosbag_play_loop"
          if="$(arg loop)"
          pkg="rosbag"
          type="play"
          args="--clock -s $(arg start) -l -r $(arg rate) $(arg bag)"
          output="screen"/>
  </group>

  <group if="$(arg regenerate_gt)">
    <group if="$(arg use_raw_phasespace)">
      <node name="phasespace_retimestamp"
            pkg="dataset_ground_truth"
            type="phasespace_retimestamp_node.py"
            output="screen">
        <param name="frame_id" value="$(arg frame_id)"/>
      </node>

      <node name="rosbag_play_raw_sources_once"
            unless="$(arg loop)"
            pkg="rosbag"
            type="play"
            args="--clock -s $(arg start) -r $(arg rate) $(arg bag) --topics /phasespace/markers /phasespace/rigids /phasespace/cameras"
            output="screen"/>

      <node name="rosbag_play_raw_sources_loop"
            if="$(arg loop)"
            pkg="rosbag"
            type="play"
            args="--clock -s $(arg start) -l -r $(arg rate) $(arg bag) --topics /phasespace/markers /phasespace/rigids /phasespace/cameras"
            output="screen"/>
    </group>

    <group unless="$(arg use_raw_phasespace)">
      <node name="rosbag_play_stamped_sources_once"
            unless="$(arg loop)"
            pkg="rosbag"
            type="play"
            args="--clock -s $(arg start) -r $(arg rate) $(arg bag) --topics /phasespace/stamped/markers /phasespace/stamped/rigids /phasespace/stamped/cameras"
            output="screen"/>

      <node name="rosbag_play_stamped_sources_loop"
            if="$(arg loop)"
            pkg="rosbag"
            type="play"
            args="--clock -s $(arg start) -l -r $(arg rate) $(arg bag) --topics /phasespace/stamped/markers /phasespace/stamped/rigids /phasespace/stamped/cameras"
            output="screen"/>
    </group>

    <include file="$(find dataset_ground_truth)/launch/multi_marker_ground_truth.launch">
      <arg name="config" value="$(arg ground_truth_config)"/>
      <arg name="world_frame" value="$(arg frame_id)"/>
    </include>

    <node name="mocap_debug_visualizer"
          pkg="dataset_ground_truth"
          type="mocap_debug_visualizer.py"
          output="screen">
      <param name="fixed_frame" value="$(arg frame_id)"/>
      <param name="markers_topic" value="/phasespace/stamped/markers"/>
      <param name="rigids_topic" value="/phasespace/stamped/rigids"/>
    </node>
  </group>

  <node if="$(arg show_rviz)"
        name="mocap_debug_rviz"
        pkg="rviz"
        type="rviz"
        args="-d $(arg rviz_config)"
        output="screen"/>
</launch>
