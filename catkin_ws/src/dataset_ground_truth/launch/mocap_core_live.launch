<launch>
  <arg name="server_ip" default="192.168.1.25"/>
  <arg name="frame_id" default="mocap_world"/>
  <arg name="ground_truth_config" default="$(find dataset_ground_truth)/config/multi_robot_markers.yaml"/>
  <arg name="show_rviz" default="true"/>
  <arg name="debug_visualizer" default="false"/>
  <arg name="rviz_config" default="$(find dataset_ground_truth)/rviz/mocap_collection_light.rviz"/>
  <arg name="respawn_phasespace" default="true"/>

  <node name="phasespace_bringup"
        pkg="phasespace_bringup"
        type="phasespace_bringup_node"
        output="screen"
        respawn="$(arg respawn_phasespace)"
        respawn_delay="3">
    <param name="server_ip" value="$(arg server_ip)"/>
  </node>

  <node name="phasespace_retimestamp"
        pkg="dataset_ground_truth"
        type="phasespace_retimestamp_node.py"
        output="screen">
    <param name="frame_id" value="$(arg frame_id)"/>
  </node>

  <include file="$(find dataset_ground_truth)/launch/multi_marker_ground_truth.launch">
    <arg name="config" value="$(arg ground_truth_config)"/>
    <arg name="world_frame" value="$(arg frame_id)"/>
  </include>

  <node if="$(arg debug_visualizer)"
        name="mocap_debug_visualizer"
        pkg="dataset_ground_truth"
        type="mocap_debug_visualizer.py"
        output="screen">
    <param name="fixed_frame" value="$(arg frame_id)"/>
    <param name="markers_topic" value="/phasespace/stamped/markers"/>
    <param name="rigids_topic" value="/phasespace/stamped/rigids"/>
  </node>

  <node if="$(arg show_rviz)"
        name="mocap_core_rviz"
        pkg="rviz"
        type="rviz"
        args="-d $(arg rviz_config)"
        output="screen"/>
</launch>
