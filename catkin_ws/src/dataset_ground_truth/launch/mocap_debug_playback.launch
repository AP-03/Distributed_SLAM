<launch>
  <arg name="bag"/>
  <arg name="frame_id" default="mocap_world"/>
  <arg name="rate" default="1.0"/>
  <arg name="start" default="0.0"/>
  <arg name="loop" default="false"/>
  <arg name="robot_id" default="robot_01"/>
  <arg name="use_marker_bootstrap_gt" default="true"/>
  <arg name="marker_ground_truth_config" default="$(find dataset_ground_truth)/config/robot_01_marker_bootstrap.yaml"/>
  <arg name="show_rviz" default="true"/>
  <arg name="rviz_config" default="$(find dataset_ground_truth)/rviz/mocap_debug.rviz"/>

  <param name="/use_sim_time" value="true"/>

  <node name="mocap_debug_visualizer"
        pkg="dataset_ground_truth"
        type="mocap_debug_visualizer.py"
        output="screen">
    <param name="fixed_frame" value="$(arg frame_id)"/>
  </node>

  <include if="$(arg use_marker_bootstrap_gt)" file="$(find dataset_ground_truth)/launch/marker_bootstrap_ground_truth.launch">
    <arg name="robot_id" value="$(arg robot_id)"/>
    <arg name="config" value="$(arg marker_ground_truth_config)"/>
    <arg name="world_frame" value="$(arg frame_id)"/>
  </include>

  <node name="rosbag_play_once"
        unless="$(arg loop)"
        pkg="rosbag"
        type="play"
        args="--clock -s $(arg start) -r $(arg rate) $(arg bag)"
        output="screen"/>

  <node name="rosbag_play_loop"
        if="$(arg loop)"
        pkg="rosbag"
        type="play"
        args="--clock -s $(arg start) -l -r $(arg rate) $(arg bag)"
        output="screen"/>

  <node if="$(arg show_rviz)"
        name="mocap_debug_rviz"
        pkg="rviz"
        type="rviz"
        args="-d $(arg rviz_config)"
        output="screen"/>
</launch>
