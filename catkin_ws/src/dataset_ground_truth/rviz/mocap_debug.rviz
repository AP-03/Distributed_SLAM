Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /LED Markers1
        - /LED Paths1
        - /Rigid Bodies1
        - /Rigid Paths1
        - /TF1
      Splitter Ratio: 0.5
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 0.5
      Color: 160; 160; 160
      Alpha: 0.35
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Name: LED Markers
      Marker Topic: /mocap_debug/led_markers
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Name: LED Paths
      Marker Topic: /mocap_debug/led_paths
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Rigid Bodies
      Marker Topic: /mocap_debug/rigid_markers
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Rigid Paths
      Marker Topic: /mocap_debug/rigid_paths
      Queue Size: 100
      Value: true
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.4
      Frame Timeout: 15
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: mocap_world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.78
      Target Frame: <Fixed Frame>
      Yaw: 0.78
Window Geometry:
  Height: 900
  Width: 1400
  X: 50
  Y: 50
