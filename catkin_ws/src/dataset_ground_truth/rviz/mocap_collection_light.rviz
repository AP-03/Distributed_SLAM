Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Robot 01 GT Path1
        - /Robot 02 GT Path1
        - /Robot 03 GT Path1
        - /Robot 04 GT Path1
        - /Robot 05 GT Path1
        - /Robot 06 GT Path1
        - /TF1
      Splitter Ratio: 0.5
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 0.5
      Color: 160; 160; 160
      Alpha: 0.35
      Value: true
    - Class: rviz/Path
      Enabled: true
      Name: Robot 01 GT Path
      Topic: /gt/robot_01/path
      Color: 255; 220; 0
      Line Style: Lines
      Line Width: 0.04
      Pose Style: None
      Queue Size: 2
      Value: true
    - Class: rviz/Path
      Enabled: true
      Name: Robot 02 GT Path
      Topic: /gt/robot_02/path
      Color: 180; 120; 255
      Line Style: Lines
      Line Width: 0.04
      Pose Style: None
      Queue Size: 2
      Value: true
    - Class: rviz/Path
      Enabled: true
      Name: Robot 03 GT Path
      Topic: /gt/robot_03/path
      Color: 80; 210; 255
      Line Style: Lines
      Line Width: 0.04
      Pose Style: None
      Queue Size: 2
      Value: true
    - Class: rviz/Path
      Enabled: true
      Name: Robot 04 GT Path
      Topic: /gt/robot_04/path
      Color: 120; 255; 80
      Line Style: Lines
      Line Width: 0.04
      Pose Style: None
      Queue Size: 2
      Value: true
    - Class: rviz/Path
      Enabled: true
      Name: Robot 05 GT Path
      Topic: /gt/robot_05/path
      Color: 255; 80; 180
      Line Style: Lines
      Line Width: 0.04
      Pose Style: None
      Queue Size: 2
      Value: true
    - Class: rviz/Path
      Enabled: true
      Name: Robot 06 GT Path
      Topic: /gt/robot_06/path
      Color: 255; 150; 50
      Line Style: Lines
      Line Width: 0.04
      Pose Style: None
      Queue Size: 2
      Value: true
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.25
      Frame Timeout: 5
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: mocap_world
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.78
      Target Frame: <Fixed Frame>
      Yaw: 0.78
Window Geometry:
  Height: 900
  Width: 1400
  X: 50
  Y: 50
