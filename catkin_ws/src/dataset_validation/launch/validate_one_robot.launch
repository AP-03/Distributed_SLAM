<launch>
  <arg name="robot_id" default="robot_01"/>
  <arg name="run_dir"/>
  <arg name="profile" default="one_robot_marker_bootstrap"/>

  <node name="validate_one_robot_run"
        pkg="dataset_validation"
        type="validate_run.py"
        output="screen"
        args="--robot_id $(arg robot_id) --run_dir $(arg run_dir) --profile $(arg profile)"/>
</launch>
