<launch>
  <param name="robot_description" textfile="$(find robot_description)/urdf/assembly.urdf"/>

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen"/>

  <node name="static_tf_base_to_camera" pkg="tf2_ros" type="static_transform_publisher"
        args="-0.300426 0.226662 -0.100389 -0.000000 -0.999992 0.003953 0.000000 base_link camera_link"/>
  <node name="static_tf_base_to_mount" pkg="tf2_ros" type="static_transform_publisher"
        args="-0.269921 0.156212 -0.093832 -0.000000 -0.999992 0.003953 0.000000 base_link mount_link"/>
  <node name="static_tf_base_to_lidar" pkg="tf2_ros" type="static_transform_publisher"
        args="0 0 0 0 0 0 1 base_link lidar_link"/>
  <node name="static_tf_camera_to_optical" pkg="tf2_ros" type="static_transform_publisher"
        args="0 0 0 -0.500000 0.500000 -0.500000 0.500000 camera_link camera_optical_frame"/>

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find robot_description)/config/robot.rviz"/>
</launch>
