<?xml version="1.0"?>
<robot name="myagv_assembly">
  <!--
    Robot description for the new full assembly STL.

    Frame convention:
      base_footprint: planar navigation frame on the floor projection.
      base_link:      physical robot body frame used for sensors and mocap.
      odom:           NOT defined here. It is a dynamic runtime/world frame.

    The new assembly mesh is a visual reference only. Sensor and mocap
    transforms below should be updated from physical measurements.

    Current CAD measurements, from the Fusion/STL coordinate frame in mm:
      base_link:   [-299.832,  24.717,   33.859]
      camera_link: [-254.500, 142.000, -160.000]
      laser_frame: [-320.430, 118.347,  -40.346]

    Fusion/STL axes are mapped into ROS as:
      ROS X forward = -Fusion Z
      ROS Y left    = -Fusion X
      ROS Z up      =  Fusion Y
  -->

  <material name="assembly_grey">
    <color rgba="0.72 0.72 0.72 1.0"/>
  </material>
  <material name="camera_black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>
  <material name="lidar_blue">
    <color rgba="0.1 0.25 0.9 1.0"/>
  </material>
  <material name="mocap_led_green">
    <color rgba="0.1 1.0 0.2 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="base_link"/>

  <joint name="base_to_assembly_mesh" type="fixed">
    <parent link="base_link"/>
    <child link="assembly_mesh_link"/>
    <!--
      The STL was exported in the Fusion coordinate frame. This origin shifts
      and rotates the measured CAD base_link point onto the URDF base_link
      frame.
      Mesh units are millimeters, hence the 0.001 scale below.
    -->
    <origin xyz="0.033859 -0.299832 -0.024717" rpy="1.57079632679 0 -1.57079632679"/>
  </joint>
  <link name="assembly_mesh_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/stl/assembly.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="assembly_grey"/>
    </visual>
  </link>

  <!--
    Lidar frame.
    Translation is from the measured Fusion point relative to base_link,
    mapped into ROS axes:
      [-320.430, 118.347, -40.346] - [-299.832, 24.717, 33.859] mm.
    TODO: replace rpy with the measured sensor orientation if the lidar frame
    axes are not aligned with base_link. The robot bag has used `laser_frame`.
  -->
  <joint name="base_to_laser_frame" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.074205 0.020598 0.093630" rpy="0 0 0"/>
  </joint>
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.05"/>
      </geometry>
      <material name="lidar_blue"/>
    </visual>
  </link>

  <!-- Backwards-compatible alias for older configs that used lidar_link. -->
  <joint name="laser_frame_to_lidar_link" type="fixed">
    <parent link="laser_frame"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link"/>

  <!--
    Camera frames.
    Translation is from the measured Fusion point relative to base_link,
    mapped into ROS axes:
      [-254.500, 142.000, -160.000] - [-299.832, 24.717, 33.859] mm.
    TODO: replace base_to_camera_link rpy with the measured camera body
    orientation if the camera frame axes are not aligned with base_link. The
    optical-frame rotations follow ROS camera convention.
  -->
  <joint name="base_to_camera_link" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.193859 -0.045332 0.117283" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.095 0.025 0.025"/>
      </geometry>
      <material name="camera_black"/>
    </visual>
  </link>

  <joint name="camera_link_to_color_frame" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_color_frame"/>

  <joint name="camera_color_frame_to_optical" type="fixed">
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <link name="camera_color_optical_frame"/>

  <joint name="camera_link_to_depth_frame" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_depth_frame"/>

  <joint name="camera_depth_frame_to_optical" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <link name="camera_depth_optical_frame"/>

  <!-- Compatibility alias for older RViz configs. -->
  <joint name="camera_color_optical_to_camera_optical_frame" type="fixed">
    <parent link="camera_color_optical_frame"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_optical_frame"/>

  <!--
    Mocap LED frames.
    TODO: replace each xyz with the measured LED center in base_link, meters.
    Keep the marker IDs matched to PhaseSpace IDs. These placeholders are
    intentionally near the top of the robot so the frames are visible in RViz.
  -->
  <joint name="base_to_mocap_led_0" type="fixed">
    <parent link="base_link"/>
    <child link="mocap_led_0"/>
    <origin xyz="-0.040 -0.060 0.160" rpy="0 0 0"/>
  </joint>
  <link name="mocap_led_0">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="mocap_led_green"/>
    </visual>
  </link>

  <joint name="base_to_mocap_led_1" type="fixed">
    <parent link="base_link"/>
    <child link="mocap_led_1"/>
    <origin xyz="0.040 -0.060 0.160" rpy="0 0 0"/>
  </joint>
  <link name="mocap_led_1">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="mocap_led_green"/>
    </visual>
  </link>

  <joint name="base_to_mocap_led_2" type="fixed">
    <parent link="base_link"/>
    <child link="mocap_led_2"/>
    <origin xyz="-0.040 0.000 0.160" rpy="0 0 0"/>
  </joint>
  <link name="mocap_led_2">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="mocap_led_green"/>
    </visual>
  </link>

  <joint name="base_to_mocap_led_3" type="fixed">
    <parent link="base_link"/>
    <child link="mocap_led_3"/>
    <origin xyz="0.040 0.000 0.160" rpy="0 0 0"/>
  </joint>
  <link name="mocap_led_3">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="mocap_led_green"/>
    </visual>
  </link>

  <joint name="base_to_mocap_led_4" type="fixed">
    <parent link="base_link"/>
    <child link="mocap_led_4"/>
    <origin xyz="-0.040 0.060 0.160" rpy="0 0 0"/>
  </joint>
  <link name="mocap_led_4">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="mocap_led_green"/>
    </visual>
  </link>

  <joint name="base_to_mocap_led_5" type="fixed">
    <parent link="base_link"/>
    <child link="mocap_led_5"/>
    <origin xyz="0.040 0.060 0.160" rpy="0 0 0"/>
  </joint>
  <link name="mocap_led_5">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="mocap_led_green"/>
    </visual>
  </link>

  <joint name="base_to_mocap_led_6" type="fixed">
    <parent link="base_link"/>
    <child link="mocap_led_6"/>
    <origin xyz="-0.080 0.000 0.190" rpy="0 0 0"/>
  </joint>
  <link name="mocap_led_6">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="mocap_led_green"/>
    </visual>
  </link>

  <joint name="base_to_mocap_led_7" type="fixed">
    <parent link="base_link"/>
    <child link="mocap_led_7"/>
    <origin xyz="0.080 0.000 0.190" rpy="0 0 0"/>
  </joint>
  <link name="mocap_led_7">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="mocap_led_green"/>
    </visual>
  </link>
</robot>
