<?xml version="1.0"?>
<robot name="myagv_assembly">
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/stl/assembly.stl" scale="1 1 1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
  </link>

  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
    <origin xyz="-0.269921 0.156212 -0.093832" rpy="-3.133687 0 3.141593"/>
  </joint>
  <link name="camera_mount_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/stl/depth_camera_mount.stl" scale="1 1 1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="-0.300426 0.226662 -0.100389" rpy="-3.133687 0 3.141593"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/stl/intel_realsense_d455.stl" scale="1 1 1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>
  <link name="camera_optical_frame"/>
</robot>
