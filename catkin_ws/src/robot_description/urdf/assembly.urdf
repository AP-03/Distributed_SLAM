<?xml version="1.0"?>
<robot name="myagv_assembly">
  <link name="base_link"/>

  <joint name="base_to_myagv" type="fixed">
    <parent link="base_link"/>
    <child link="myagv_link"/>
    <origin xyz="0.049350 -0.012983 -0.117401" rpy="0 0 0"/>
  </joint>
  <link name="myagv_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/stl/assembly.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <material name="light_grey">
        <color rgba="0.75 0.75 0.75 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Keep lidar_link and odom_link coincident with base_link -->
  <joint name="base_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link"/>

  <joint name="base_to_odom" type="fixed">
    <parent link="base_link"/>
    <child link="odom_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="odom_link"/>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link"/>

  <joint name="mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mount_link"/>
    <origin xyz="-0.220571 0.143229 -0.211233" rpy="-3.133687 0 3.141593"/>
  </joint>
  <link name="mount_link"/>

  <joint name="camera_joint" type="fixed">
    <parent link="mount_link"/>
    <child link="camera_link"/>
    <origin xyz="0.030505 0.070500 0.006000" rpy="0 0 0"/>
  </joint>
  <link name="camera_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>
  <link name="camera_optical_frame"/>
</robot>
