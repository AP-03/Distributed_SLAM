<?xml version="1.0"?>
<robot name="myagv_assembly">
  <link name="base_link"/>

  <joint name="base_to_myagv" type="fixed">
    <parent link="base_link"/>
    <child link="myagv_link"/>
    <origin xyz="-0.033431 0.298771 -0.159316" rpy="1.578702 0.007906 1.570796"/>
  </joint>
  <link name="myagv_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/stl/assembly.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="light_grey">
        <color rgba="0.75 0.75 0.75 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Keep lidar_link and odom_link coincident with base_link -->
  <joint name="base_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link"/>

  <joint name="base_to_odom" type="fixed">
    <parent link="base_link"/>
    <child link="odom_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="odom_link"/>

  <joint name="mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mount_link"/>
    <origin xyz="-0.126025 0.030099 -0.000238" rpy="1.570796 -0.007906 -1.570796"/>
  </joint>
  <link name="mount_link"/>

  <joint name="camera_joint" type="fixed">
    <parent link="mount_link"/>
    <child link="camera_link"/>
    <origin xyz="0.030505 0.070500 0.006000" rpy="0 0 0"/>
  </joint>
  <link name="camera_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>
  <link name="camera_optical_frame"/>

  <joint name="base_to_led_marker" type="fixed">
    <parent link="base_link"/>
    <child link="led_marker_link"/>
    <origin xyz="-0.015025 0.002880 -0.000023" rpy="0 0 0"/>
  </joint>
  <link name="led_marker_link"/>

  <!--
  Conversion notes (from Assembly_placements.json, units in mm unless noted):

  Base frame (global from Fusion):
    base_link_global = (-34.325, 10.103, 117.424)
    base_link_rpy = (0, 0, 0)

  Relative transform rule used for URDF joints:
    p_rel = p_part_global - p_base_global
    R_rel = R_base^T * R_part
  Since base_link_rpy = (0,0,0), R_base is identity and:
    p_rel = p_part_global - p_base_global

  Example calculations (global -> relative):
    myAGV v2 global = (-67.756, 308.874, -41.892)
    p_rel = (-67.756, 308.874, -41.892) - (-34.325, 10.103, 117.424)
          = (-33.431, 298.771, -159.316)  mm
    rpy_rel = (1.578702, 0.007906, 1.570796)

    DepthCamera_Mount v8 global = (-160.350, 40.202, 117.186)
    p_rel = (-160.350, 40.202, 117.186) - (-34.325, 10.103, 117.424)
          = (-126.025, 30.099, -0.238)   mm
    rpy_rel = (1.570796, -0.007906, -1.570796)

    Intel Realsense D455 v2 global = (-166.350, 10.256, 187.925)
    p_rel = (-166.350, 10.256, 187.925) - (-34.325, 10.103, 117.424)
          = (-132.025, 0.153, 70.501)  mm
    rpy_rel = (1.570796, -0.007906, -1.570796)

    LED marker global = (-49.35, 12.983, 117.401)
    p_rel = (-49.35, 12.983, 117.401) - (-34.325, 10.103, 117.424)
          = (-15.025, 2.880, -0.023)  mm
    rpy_rel = (0, 0, 0)

  Camera relative to mount (from JSON):
    camera_rel_mount = (30.505, 70.500, 6.000) mm, rpy = (0,0,0)

  All URDF xyz values are meters (mm / 1000).
  -->
</robot>
