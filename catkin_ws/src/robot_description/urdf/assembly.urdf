<?xml version="1.0"?>
<robot name="myagv_assembly">

  <!-- ============================================================
       TF CHAIN OVERVIEW
       ============================================================
       From the bag file (you do NOT define these):
         odom -> base_footprint -> base_link    (wheel odometry)
         base_footprint -> laser_frame           (manufacturer lidar calibration)
         base_footprint -> base_up
         camera_link -> camera_depth_frame -> camera_depth_optical_frame
         camera_link -> camera_color_frame -> camera_color_optical_frame
         camera_link -> camera_aligned_depth_to_color_frame

       From this URDF via robot_state_publisher:
         base_link -> myagv_link                 (visual mesh)
         base_link -> mount_link -> camera_link -> camera_optical_frame
         base_link -> mocap_link                 (for mocap ground truth)

       DO NOT define odom, base_footprint, lidar_link, laser_frame,
       or the camera depth/color sub-frames here — they come from
       the bag and you would create conflicts.
       ============================================================ -->

  <link name="base_link"/>

  <!-- Visual mesh -->
  <joint name="base_to_myagv" type="fixed"> 
    <parent link="base_link"/>
    <child link="myagv_link"/>
    <origin xyz="-0.018406 0.295891 0.159293" rpy="1.578702 0.007906 1.570796"/>
  </joint>
  <link name="myagv_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/stl/assembly.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="light_grey">
        <color rgba="0.75 0.75 0.75 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Camera mount and camera -->
  <joint name="mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mount_link"/>
    <origin xyz="-0.111000 0.027219 -0.000215" rpy="1.570796 -0.007906 -1.570796"/>
  </joint>
  <link name="mount_link"/>

  <joint name="camera_joint" type="fixed">
    <parent link="mount_link"/>
    <child link="camera_link"/>
    <origin xyz="0.030505 0.070500 0.006000" rpy="0 0 0"/>
  </joint>
  <link name="camera_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <!-- Standard ROS optical frame: Z-forward, X-right, Y-down -->
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>
  <link name="camera_optical_frame"/>

  <!-- Mocap reference point.
       TODO: Measure the offset from base_link to the divot where
       your reference mocap LED sits. Your mocap system will publish
       mocap_world -> mocap_link for ground truth. -->
  <joint name="base_to_mocap" type="fixed">
    <parent link="base_link"/>
    <child link="mocap_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="mocap_link"/>

</robot>